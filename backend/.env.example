PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase values will be connected in Development Step 2.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Microsoft Graph values will be connected in Development Step 4.
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_DIRECTORY_TENANT_ID=your-directory-tenant-id
MICROSOFT_AUTHORITY_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback
